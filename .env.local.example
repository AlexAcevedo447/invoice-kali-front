# Override para desarrollo 100% local (sin Docker).
# Copia este archivo a .env.local:
#   cp .env.local.example .env.local
#
# Vite lo carga automaticamente y tiene prioridad sobre .env.dev.
# .env.local ya esta ignorado por git.

# Auth service (APP_PORT=8082 en su .env local)
API_BASE_URL=http://localhost:8082

# Invoicing service (APP_PORT=8083 en su .env local)
INVOICING_API_BASE_URL=http://localhost:8083
