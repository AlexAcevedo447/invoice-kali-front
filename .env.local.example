# Override para ejecutar el frontend en el host con `npm run dev` (Vite en :5173).
# Copia este archivo a .env.local:
#   cp .env.local.example .env.local
#
# Vite lo carga automaticamente. .env.local ya esta ignorado por git.
# Los puertos coinciden con los publicados por los docker-compose de desarrollo:
#   kali-auth-context    -> docker-compose.dev.yml (API_HOST_PORT=18080)
#   kali-invoice-service -> docker-compose.dev.yml (APP_PORT=8080)
# Son tambien los que usa kali-invoice-tests (cypress/config/environments/local.json).

# Auth service
API_BASE_URL=http://localhost:18080

# Invoicing service
INVOICING_API_BASE_URL=http://localhost:8080
