# Configuración de DESARROLLO LOCAL para docker-compose.dev.yml:
#   cp .env.example .env.dev      (npm run stack:up lo hace solo si falta)
# Para `npm run dev` en el host usa .env.local.example (proxies a localhost).

# Shared environment variables
VITE_API_BASE_URL=/

# Development server config (Vite dentro del contenedor en 5173, publicado en 15173)
VITE_HOST=0.0.0.0
VITE_PORT=5173
FRONTEND_HOST_PORT=15173

# Destinos del proxy de Vite dentro de Docker: el contenedor del front se une a
# las redes kali-auth-dev-net y kali-dev-net y llega a los servicios por nombre.
API_BASE_URL=http://auth-api:8080
INVOICING_API_BASE_URL=http://invoice-api:8080

# Production host port for nginx container
FRONTEND_PROD_HOST_PORT=15080
