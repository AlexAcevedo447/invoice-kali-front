# Configuración de `npm run stack:up` / `stack:down`.
# Opcional: solo hace falta si tus repos NO son hermanos de este.
#   cp .env.stack.example .env.stack   (.env.stack está ignorado por git)
#
# Las rutas relativas se resuelven desde la raíz de ESTE repo (invoice-kali-front).
# También se aceptan rutas absolutas. No pongas secretos aquí: las credenciales
# viven en el .env.dev de cada repo.

# Repositorio de autenticación (kali-auth-context)
# Ejemplo con otra estructura de carpetas: AUTH_PROJECT_PATH=../../Back/kali-auth-context
AUTH_PROJECT_PATH=../kali-auth-context
AUTH_COMPOSE_FILE=docker-compose.dev.yml
AUTH_ENV_FILE=.env.dev
# Publica la API en el host en 18080 (API_HOST_PORT de su .env.dev).

# Repositorio de facturación (kali-invoice-service)
# Ejemplo con otra estructura de carpetas: INVOICING_PROJECT_PATH=../../KALI/kali-invoice-service
INVOICING_PROJECT_PATH=../kali-invoice-service
# docker-compose.dev.yml: API con hot-reload (recomendado).
# docker-compose.debug.yml: API con Delve en 127.0.0.1:40000 y BD de debug propia.
INVOICING_COMPOSE_FILE=docker-compose.dev.yml
INVOICING_ENV_FILE=.env.dev
# Publica la API en el host en 8080 y Postgres en 5432.

# Frontend (este repo): publica Vite en 15173.
FRONT_COMPOSE_FILE=docker-compose.dev.yml
FRONT_ENV_FILE=.env.dev
